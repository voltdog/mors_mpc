 using namespace gtsam;
 
+//@ Key poses rotate a cloud as transformPointCloud does: yaw, then roll, then pitch,
+//@ i.e. R = Ry(pitch) * Rx(roll) * Rz(yaw) in camera_init. tf2 setRPY builds Rz * Ry * Rx,
+//@ which differs once more than one angle is non-zero (any heading with a tilted sensor).
+static tf2::Quaternion keyPoseRotation(const PointTypePose &pose){
+  return tf2::Quaternion(tf2::Vector3(0, 1, 0), pose.pitch) *
+         tf2::Quaternion(tf2::Vector3(1, 0, 0), pose.roll) *
+         tf2::Quaternion(tf2::Vector3(0, 0, 1), pose.yaw);
+}
