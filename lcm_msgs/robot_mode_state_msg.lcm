package mors_msgs;
struct robot_mode_state_msg
{
    const int8_t PASSIVE = 0;
    const int8_t STANDUP = 1;
    const int8_t STANDING = 2;
    const int8_t LOCOMOTION = 3;
    const int8_t ACTION = 4;
    const int8_t EXTERNAL = 5;
    const int8_t LAYDOWN = 6;
    const int8_t FAILURE = 7;

    int8_t current_state;
    int8_t target_state;
    
    int8_t cur_algorithm; 
    int8_t cur_action;
    int8_t cur_params;
    
    boolean fault;
    string fault_str;
}
