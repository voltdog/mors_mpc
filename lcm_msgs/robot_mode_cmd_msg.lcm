package mors_msgs;
struct robot_mode_cmd_msg
{
    // values for command
    const int8_t SET_MODE = 0, START_ACTION = 1, CANCEL_ACTION = 2;
    const int8_t SET_ALGORITHM = 3, ESTOP = 4, CLEAR_FAULT = 5, SET_EXTERNAL = 6;

    // values for target when SET_MODE
    const int8_t PASSIVE = 0, STANDUP = 1, BALANCE = 2, LOCOMOTION = 3;
    const int8_t ACTION = 4, EXTERNAL = 5, LAYDOWN = 6;

    int8_t command;
    int16_t target; // SET_MODE: mode; SET_ALGORITHM/START_ACTION: ID 0..255; otherwise ignored.
}
 