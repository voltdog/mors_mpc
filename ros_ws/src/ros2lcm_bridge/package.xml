<?xml version="1.0"?>
<package format="3">
  <name>ros2lcm_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 transport for FSMLocomotion commands, state and results.</description>
  <maintainer email="vldanilov90@gmail.com">MORS developers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>mors_ros_msgs</depend>
  <depend>action_msgs</depend>
  <build_depend>liblcm-dev</build_depend>
  <exec_depend>python3-lcm</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
