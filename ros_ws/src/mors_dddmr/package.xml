<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mors_dddmr</name>
  <version>0.0.0</version>
  <description>Launch files and configs of the dddmr_navigation stack (mapping, localization, navigation) for MORS with Robosense Airy lidar</description>
  <maintainer email="vldanilov90@gmail.com">yoggi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- dddmr packages exist only in the dddmr docker image -->
  <exec_depend>lego_loam_bor</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>p2p_move_base</exec_depend>
  <exec_depend>mcl_3dl</exec_depend>
  <exec_depend>dddmr_pg_map_server</exec_depend>
  <exec_depend>dddmr_rviz_default_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
